<?xml version="1.0"?>

<jetscape>
  
  <nEvents> 1000000 </nEvents>
  
  <outputFilename>/scratch/user/cameron.parker/projects/runs/pp/pp200gunnew/test_out</outputFilename>
  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  
  <!-- Hard Process -->
  <Hard>
    <PhotonGun>
        <name>PhotonGun</name>
        <min_pT>0.5</min_pT>
        <max_pT>20.0</max_pT>
        <Ecm>200</Ecm>
        <eta_max>1.0</eta_max>
      </PhotonGun>
  </Hard>
  
  <!-- Photon Module: no medium, hard/shower photons go directly to the final state -->
  <Photons>
    <gammaLoss>
      <thermalEmission>0</thermalEmission>
      <reabsorption>0</reabsorption>
      <hadronGas>0</hadronGas>
    </gammaLoss>
  </Photons>

  <!--Eloss Modules -->
  <Eloss>
    <Matter> 
      <Q0> 1.0 </Q0>
      <in_vac> 1 </in_vac>
      <vir_factor> 0.25 </vir_factor>
      <recoil_on> 0 </recoil_on>
      <broadening_on> 0 </broadening_on>
      <brick_med> 0 </brick_med>
    </Matter>
  </Eloss>
  
  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
    <tau0Max>10.0</tau0Max>
  </JetHadronization>
  
</jetscape>