<?xml version="1.0"?>

<jetscape>

  <nEvents> 100 </nEvents>
  <setReuseHydro> true </setReuseHydro>
  <nReuseHydro> 100 </nReuseHydro>

  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  <outputFilename>test_out</outputFilename>
  <vlevel> 0 </vlevel>
  <nEvents_printout> 1 </nEvents_printout>
  <enableAutomaticTaskListDetermination> true </enableAutomaticTaskListDetermination>

  <Random>
    <seed>0</seed>
  </Random>
  
  <!-- Inital State Module  -->
  <IS>
    <grid_max_x> 20 </grid_max_x>
    <grid_max_y> 20 </grid_max_y>
    <grid_max_z> 0 </grid_max_z>
    <!--  <grid_step_x> 0.2 </grid_step_x>
    <grid_step_y> 0.2 </grid_step_y> -->
    <grid_step_x> 0.2 </grid_step_x>
    <grid_step_y> 0.2 </grid_step_y>

    <Trento>
    <PhysicsInputs  projectile='Pb'
            target='Pb'
            sqrts='2760'
            cross-section='6.7'
            normalization='16.0'>
    </PhysicsInputs>
    <CutInputs
            centrality-low='20'
            centrality-high='40'>
    </CutInputs>
    <TransInputs  reduced-thickness='0.007'
            fluctuation="0.918"
            nucleon-width="0.956"
            nucleon-min-dist="1.27">
    </TransInputs>
    <LongiInputs  mean-coeff="1.0"
            std-coeff="3.0"
            skew-coeff="0.0"
            skew-type="1"
            jacobian="0.8">
        </LongiInputs>
    </Trento>
  </IS>

  <!-- Hard Process -->
  <Hard>
    <PhotonGun>
      <name>PhotonGun</name>
      <min_pT>0.5</min_pT>
      <max_pT>20.0</max_pT>
      <Ecm>2760</Ecm>
      <eta_max>2.0</eta_max>
    </PhotonGun>
  </Hard>

  <!--Preequilibrium Dynamics Module -->
  <Preequilibrium>
    <!-- starting long. proper time for Preequilibrium dynamics -->
    <tau0>0.0</tau0>
    <tauj>0.1</tauj>
    <!-- switching long. proper time from Preequilibrium dynamics to Hydrodynamics (Landau Matching) -->
    <taus>1.46</taus>
    <evolutionInMemory>1</evolutionInMemory>

    <!-- Individual Preequilibrium Dynamics models  -->
    <FreestreamMilne>
      <name>FreestreamMilne</name>
      <freestream_input_file>freestream_input</freestream_input_file>
      <E_DEP_FS>1</E_DEP_FS>
    </FreestreamMilne>
  </Preequilibrium>

  <!-- Hydro  Module  -->
  <Hydro>
    <MUSIC>
      <beastMode>0</beastMode>
      <MUSIC_input_file>../external_packages/gammaLoss/config/photon/music_input</MUSIC_input_file>
      <output_evolution_to_file>0</output_evolution_to_file>
      <output_evolution_to_memory>1</output_evolution_to_memory>
      <surface_in_memory>1</surface_in_memory>
      <Initial_time_tau_0>1.46</Initial_time_tau_0>
      <T_dependent_Shear_to_S_ratio>3</T_dependent_Shear_to_S_ratio>
      <shear_viscosity_3_T_kink_in_GeV>0.223</shear_viscosity_3_T_kink_in_GeV>
      <shear_viscosity_3_low_T_slope_in_GeV>-0.776</shear_viscosity_3_low_T_slope_in_GeV>
      <shear_viscosity_3_high_T_slope_in_GeV>0.37</shear_viscosity_3_high_T_slope_in_GeV>
      <shear_viscosity_3_at_kink>0.096</shear_viscosity_3_at_kink>
      <temperature_dependent_bulk_viscosity>3</temperature_dependent_bulk_viscosity>
      <bulk_viscosity_3_max>0.133</bulk_viscosity_3_max>
      <bulk_viscosity_3_T_peak_in_GeV>0.12</bulk_viscosity_3_T_peak_in_GeV>
      <bulk_viscosity_3_width_in_GeV>0.072</bulk_viscosity_3_width_in_GeV>
      <bulk_viscosity_3_lambda_asymm>-0.122</bulk_viscosity_3_lambda_asymm>
      <freezeout_temperature>0.1173</freezeout_temperature>
    </MUSIC>
  </Hydro>
  <!-- Photon Modules: run after the medium and energy loss, before jet hadronization -->
  <Photons>
    <gammaLoss>
        <source>2</source>
        <thermalEmission> 1 </thermalEmission>
        <hadronGas>1</hadronGas>
        <pseudoCriticalEnhancement>1</pseudoCriticalEnhancement>
        <baseEnhancement>1.0</baseEnhancement>
        <pseudoCriticalEnhancementStrength>5.0</pseudoCriticalEnhancementStrength>
        <pseudoCriticalEnhancementWidth>0.005</pseudoCriticalEnhancementWidth>
        <reabsorption>1</reabsorption>
        <vacToHadron>0.1173</vacToHadron>
        <absFactor>1.0</absFactor>
        <emissionFactor>25.0</emissionFactor>
        <tStartOffset>0.01</tStartOffset>
        <emissionEveryEvent>1</emissionEveryEvent>
        <resample>1</resample>
    </gammaLoss>
  </Photons>

  <!--Eloss Modules -->
  <Eloss>

    <deltaT>0.1</deltaT>
    <formTime> -0.1</formTime>
    <maxT>150</maxT>
    <tStart> 0.6 </tStart> <!-- Start time of jet quenching, proper time, fm/c   -->
    <mutex>ON</mutex>

  </Eloss>

  <SoftParticlization>
    <iSS>
      <iSS_input_file>../external_packages/iSS/iSS_parameters.dat</iSS_input_file>
      <!-- file path for the default table files  -->
      <iSS_table_path>../external_packages/iSS/iSS_tables</iSS_table_path>
      <!-- file path for the default particle table files  -->
      <iSS_particle_table_path>../external_packages/iSS/iSS_tables</iSS_particle_table_path>
      <afterburner_type>2</afterburner_type>
      <number_of_repeated_sampling>1</number_of_repeated_sampling>
      <Perform_resonance_decays>0</Perform_resonance_decays>
    </iSS>
  </SoftParticlization>

  <!-- Hadronic Afterburner  -->
  <Afterburner>
    <!-- SMASH -->
    <SMASH>
      <name>SMASH</name>
      <SMASH_config_file>../external_packages/smash/smash_config.yaml</SMASH_config_file>
      <SMASH_particles_file>../external_packages/smash/smash_code/input/particles.txt</SMASH_particles_file>
      <SMASH_decaymodes_file>../external_packages/smash/smash_code/input/decaymodes.txt</SMASH_decaymodes_file>
    </SMASH>
  </Afterburner>

</jetscape>
