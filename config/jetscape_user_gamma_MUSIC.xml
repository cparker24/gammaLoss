<?xml version="1.0"?>

<!-- Thermal and jet photons with reabsorption in a MUSIC medium (requires USE_ROOT with MathMore and USE_MUSIC) -->
<jetscape>

  <nEvents> 10 </nEvents>
  <setReuseHydro> true </setReuseHydro>
  <nReuseHydro> 10 </nReuseHydro>

  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>
  <outputFilename>test_out_gamma</outputFilename>
  <vlevel> 0 </vlevel>
  <nEvents_printout> 1 </nEvents_printout>
  <enableAutomaticTaskListDetermination> true </enableAutomaticTaskListDetermination>

  <Random>
    <seed>0</seed>
  </Random>

  <!-- Inital State Module  -->
  <IS>
    <grid_max_x> 15 </grid_max_x>
    <grid_max_y> 15 </grid_max_y>
    <grid_max_z> 0 </grid_max_z>
    <grid_step_x> 0.2 </grid_step_x>
    <grid_step_y> 0.2 </grid_step_y>
    <Trento>
    <PhysicsInputs  projectile='Pb'
            target='Pb'
            sqrts='2760'
            cross-section='4.2'
            normalization='5.73'>
    </PhysicsInputs>
    <CutInputs  centrality-low='20'
          centrality-high='40'>
    </CutInputs>
    <TransInputs  reduced-thickness='0.0'
            fluctuation="1.2"
            nucleon-width="0.9"
            nucleon-min-dist="1.2">
    </TransInputs>
    <LongiInputs  mean-coeff="1.0"
            std-coeff="3.0"
            skew-coeff="0.0"
            skew-type="1"
            jacobian="0.8">
    </LongiInputs>
    </Trento>
  </IS>

  <!-- Hard Process -->
  <Hard>
    <PythiaGun>
      <FSR_on>0</FSR_on>
      <pTHatMin>0</pTHatMin>
      <pTHatMax>55</pTHatMax>
      <eCM>2760</eCM>
    </PythiaGun>
  </Hard>

  <!--Preequilibrium Dynamics Module -->
  <Preequilibrium>
    <NullPreDynamics> </NullPreDynamics>
  </Preequilibrium>

  <!-- Hydro  Module  -->
  <Hydro>
      <MUSIC>
          <beastMode>1</beastMode>
          <InitialProfile>42</InitialProfile>
          <Initial_time_tau_0>0.6</Initial_time_tau_0>
          <freezeout_temperature>0.154</freezeout_temperature>
          <shear_viscosity_eta_over_s>0.10</shear_viscosity_eta_over_s>
          <output_evolution_to_memory>1</output_evolution_to_memory>
      </MUSIC>
  </Hydro>

  <!-- Photon Modules: run after the medium and energy loss, before jet hadronization -->
  <Photons>
    <gammaLoss>
        <source>2</source>
        <thermalEmission>1</thermalEmission>
        <hadronGas>1</hadronGas>
        <hadronGasTablePath>../external_packages/gammaLoss/tables</hadronGasTablePath>
        <pseudoCriticalEnhancement>1</pseudoCriticalEnhancement>
        <emissionEveryEvent>0</emissionEveryEvent>
        <reabsorption>1</reabsorption>
        <jetPhotonReabsorption>1</jetPhotonReabsorption>
    </gammaLoss>
  </Photons>

  <!--Eloss Modules -->
  <Eloss>
    <deltaT>0.1</deltaT>
    <formTime> -0.1</formTime>
    <maxT>20</maxT>
    <tStart> 0.6 </tStart>
    <mutex>ON</mutex>

    <Matter>
      <name>Matter</name>
      <matter_on> 1 </matter_on>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <recoil_on> 1 </recoil_on>
      <hydro_Tc> 0.154 </hydro_Tc>
      <QhatParametrizationType> 5  </QhatParametrizationType>
      <qhat0> -2.0 </qhat0>
      <alphas> 0.3 </alphas>
      <qhatA> 10.0 </qhatA>
      <qhatB> 100.0 </qhatB>
    </Matter>

    <Lbt>
      <name> Lbt </name>
      <Q0> 2.0 </Q0>
      <in_vac> 0 </in_vac>
      <only_leading> 0 </only_leading>
      <hydro_Tc> 0.16 </hydro_Tc>
      <alphas> 0.3 </alphas>
      <run_alphas>1</run_alphas>
    </Lbt>
  </Eloss>

  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
    <take_recoil>1</take_recoil>
    <eCMforHadronization>0</eCMforHadronization>
  </JetHadronization>

</jetscape>
